# Copy to .env and fill in. Never commit the real .env.
ABS_URL=http://localhost:13378
ABS_API_KEY=your-audiobookshelf-api-key
OPENAI_API_KEY=your-openai-api-key

# Optional: if omitted, the service creates data/public_token.txt.
PUBLIC_TOKEN=

# 12 hours. The image is generated only when the shelf fingerprint changes.
POLL_SECONDS=43200

# 1080p 21:9 profile. For 4K use 3840x1648.
BOOKSHELF_IMAGE_MODEL=gpt-image-2
BOOKSHELF_IMAGE_QUALITY=high
BOOKSHELF_IMAGE_WIDTH=2528
BOOKSHELF_IMAGE_HEIGHT=1088
BOOKSHELF_ASPECT_LABEL=21:9
BOOKSHELF_BOOK_COUNT=20
